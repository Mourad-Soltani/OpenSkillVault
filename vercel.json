{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    },
    {
      "src": "frontend/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { "src": "/styles.css", "dest": "/frontend/styles.css" },
    { "src": "/app.js", "dest": "/frontend/app.js" },
    { "src": "/favicon.ico", "dest": "/frontend/index.html" },
    { "src": "/(.*)", "dest": "/api/index.py" }
  ]
}
